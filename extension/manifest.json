{
  "manifest_version": 3,
  "name": "AutoTailor AI — Autonomous ATS Autofill & Career Agent",
  "version": "1.2.0",
  "description": "Apple-grade autonomous ATS autofill assistant for Shamir Khan (Laurier CS). Automatically fills Workday, IBM, Greenhouse, Lever, Ashby, SmartRecruiters, Taleo, and all tech application portals.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "clipboardWrite"
  ],
  "host_permissions": [
    "http://127.0.0.1:8500/*",
    "http://localhost:8500/*",
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AutoTailor AI Assistant",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "js": ["content.js"],
      "css": ["floating.css"],
      "run_at": "document_idle"
    }
  ]
}
